{
  "name": "playwright-qa-course",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright + TypeScript QA automation course — written chapters (VitePress) plus a companion framework tested against the Inkwell SUT.",
  "scripts": {
    "test": "npx playwright test",
    "test:chrome": "npx playwright test --project='ui chrome'",
    "test:firefox": "npx playwright test --project='ui firefox'",
    "test:webkit": "npx playwright test --project='ui webkit'",
    "test:mobile": "npx playwright test --project='ui mobile-*'",
    "test:ci": "npx playwright test --project='ui chrome' --project='ui firefox' --project='ui webkit' --project='ui mobile-iphone'",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "blog:devto": "node --env-file=.env scripts/devto-sync.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ehuelsmann/openapi-validator": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "eslint": "^10.9.0",
    "gray-matter": "^4.0.3",
    "phantom-report": "^1.1.0",
    "playwright-schema-validator": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.6.3"
  }
}
